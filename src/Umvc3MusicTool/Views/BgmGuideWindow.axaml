<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:Umvc3MusicTool.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="620" d:DesignHeight="680"
        x:Class="Umvc3MusicTool.Views.BgmGuideWindow"
        Icon="/Assets/avalonia-logo.ico"
        Title="BGM Filename Index Guide"
        Width="620" Height="680"
        MinWidth="480" MinHeight="500">

    <Window.Resources>
        <DataTemplate x:Key="BgmEntryTemplate" x:DataType="views:BgmGuideEntry">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Click="OnCopyFileName"
                        FontFamily="Consolas, Courier New, monospace"
                        Padding="6,1" ToolTip.Tip="Click to copy filename">
                    <TextBlock Text="{Binding FileName}"/>
                </Button>
                <TextBlock Text=" - " VerticalAlignment="Center" FontFamily="Consolas, Courier New, monospace"/>
                <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" FontFamily="Consolas, Courier New, monospace"/>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid RowDefinitions="Auto,*,Auto" Margin="12" RowSpacing="8">

        <TextBlock Text="BGM files are named bgm_cr_###.sngw (character themes), bgm_gm_###.sngw (game modes) and bgm_st_###.sngw (stages)."
                   TextWrapping="Wrap"/>

        <TabControl Grid.Row="1">
            <TabItem Header="Character Music (bgm_cr_)">
                <ScrollViewer>
                    <ItemsControl x:Name="CrItems" ItemTemplate="{StaticResource BgmEntryTemplate}" Margin="8"/>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Game Music (bgm_gm_)">
                <ScrollViewer>
                    <ItemsControl x:Name="GmItems" ItemTemplate="{StaticResource BgmEntryTemplate}" Margin="8"/>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Stage Music (bgm_st_)">
                <ScrollViewer>
                    <ItemsControl x:Name="StItems" ItemTemplate="{StaticResource BgmEntryTemplate}" Margin="8"/>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <TextBlock x:Name="StatusText" Grid.Row="2" Text=""
                   Foreground="{DynamicResource SystemControlForegroundAccentBrush}"/>

    </Grid>
</Window>
